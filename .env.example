# ========================================================
# Enterprise AI Research & Document Agent - Configuration
# ========================================================

# Server & Network Configuration
ENVIRONMENT=development
DEBUG=False
PORT=8000
HOST=0.0.0.0
PROJECT_NAME="Enterprise AI Research & Document Agent"
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-frontend.vercel.app

# Security & Authentication
# In production, generate a secure random key: openssl rand -hex 32
SECRET_KEY=change-this-to-a-super-secret-random-hex-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL for Production, SQLite for local dev)
# Example PostgreSQL: postgresql://username:password@host:5432/enterprise_agent
DATABASE_URL=sqlite:///./enterprise_agent.db

# Cache & Message Broker (Redis)
REDIS_URL=redis://localhost:6379/0
USE_REDIS_CACHE=False

# Vector Database (Qdrant Cloud or InMemory)
# Options: "inmemory" or "qdrant"
VECTOR_DB_TYPE=inmemory
# Example Qdrant Cloud: https://xyz-example.eu-central.aws.cloud.qdrant.io:6333
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=enterprise_document_chunks

# LLM Providers & API Keys (Leave blank to use built-in local deterministic fallback engine)
DEFAULT_LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LLM Models
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Embedding Configuration
# Options: "local" (TF-IDF/Hashing 384d, zero API cost) or "gemini" / "openai"
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSION=384

# RAG Pipeline Hyperparameters
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.55
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=100

# File Storage (Local Disk or S3-Compatible Storage)
STORAGE_DIR=./storage/uploads
MAX_FILE_SIZE_MB=50

# S3 Object Storage (AWS S3, Cloudflare R2, MinIO)
USE_S3_STORAGE=False
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_ENDPOINT_URL=

# Frontend Environment (Vite)
# Set in frontend/.env or hosting provider (e.g. Vercel / Render Static Site)
VITE_API_URL=http://localhost:8000/api/v1
